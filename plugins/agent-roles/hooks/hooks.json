{
  "description": "Injects the orchestrator role into the top-level session, the task worker role into every subagent, and the resident worker role into the agent types that stay alive and report by message",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-role.sh\" SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-role.sh\" SubagentStart",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
