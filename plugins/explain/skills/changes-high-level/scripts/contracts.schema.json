{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts.schema.json",
  "title": "explain subdomain fragments and the merged contracts.json",
  "$defs": {
    "fragment": {
      "type": "object",
      "properties": {
        "area": {
          "type": "string",
          "minLength": 1
        },
        "checklist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checklist_entry"
          }
        },
        "contracts": {
          "$ref": "#/$defs/contracts"
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "notes": {
          "$ref": "#/$defs/notes"
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "service_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service_link"
          }
        },
        "entry_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry_point"
          }
        },
        "far_side_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/far_side_read"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "area",
        "checklist"
      ]
    },
    "merged": {
      "type": "object",
      "properties": {
        "areas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/table"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundary"
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "areas": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "differs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "kind",
              "key",
              "areas",
              "differs"
            ]
          }
        },
        "checklist_gaps": {
          "type": "array",
          "description": "Contract files from the surface scan that no fragment covered, or that a fragment left unknown.",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "area": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service"
          }
        },
        "service_links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/service_link"
          }
        },
        "entry_points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry_point"
          }
        },
        "far_side_reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/far_side_read"
          }
        }
      },
      "additionalProperties": false,
      "required": [
