        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "proposed": {
          "type": "boolean"
        },
        "foreign_key": {
          "type": "boolean",
          "description": "false when `references` names a logical reference with no foreign key constraint; the page says so and draws the edge dashed."
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "status"
      ]
    },
    "was": {
      "type": "object",
      "properties": {
