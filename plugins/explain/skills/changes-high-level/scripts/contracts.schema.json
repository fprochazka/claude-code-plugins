    "cost": {
      "type": "object",
      "properties": {
        "labels": {
          "type": "array",
          "items": {
            "enum": [
              "code change only",
              "data migration",
              "multi-step change",
              "downtime or failover",
              "other consumers must change",
              "drops data"
            ]
          }
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Markdown subset: `code`, **bold** and [text](https://...). Everything else is shown as text."
        }
      },
      "additionalProperties": false,
      "required": [
        "labels"
      ]
    },
    "rollout": {
      "type": "object",
      "properties": {
        "label": {
          "enum": [
            "backward compatible",
            "needs deploy order",
            "breaks existing callers",
            "unknown"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Markdown subset: `code`, **bold** and [text](https://...). Everything else is shown as text."
        },
        "rollback": {
          "type": "string",
          "minLength": 1,
          "description": "What rolling the deploy back does to this object: harmless, needs a down migration, loses data. Markdown subset: `code`, **bold** and [text](https://...). Everything else is shown as text."
        }
      },
      "additionalProperties": false,
      "required": [
        "label"
      ]
    },
    "column": {
