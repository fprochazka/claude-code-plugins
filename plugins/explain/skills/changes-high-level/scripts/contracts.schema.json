          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/boundary"
          }
        }
      },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "added",
            "removed",
            "changed",
            "unchanged",
            "accessed",
            "semantics changed"
          ]
        },
        "source": {
          "enum": [
            "migration",
            "entity",
            "schema dump",
            "spec",
            "declaration",
            "code",
            "config",
            "source text",
            "inferred"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "proposed": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Markdown subset: `code`, **bold** and [text](https://...). Everything else is shown as text."
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "rollout": {
          "$ref": "#/$defs/rollout"
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "added",
                  "removed",
                  "changed",
                  "unchanged",
                  "accessed",
                  "semantics changed"
                ]
              },
              "proposed": {
                "type": "boolean"
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "description": "Markdown subset: `code`, **bold** and [text](https://...). Everything else is shown as text."
              }
            },
            "additionalProperties": false,
            "required": [
              "text",
              "status"
            ]
          }
        },
        "unchanged_columns": {
          "type": "integer",
          "minimum": 0
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "accesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/access"
          }
        },
        "lead": {
          "type": "string",
          "minLength": 1,
          "description": "One sentence a reader can decide on before any detail: what changed and what it means for rollout or the callers. A fact, not a verdict. Markdown subset: `code`, **bold** and [text](https://...). Everything else is shown as text."
        },
        "dialect": {
          "enum": [
            "postgresql",
            "mysql",
            "mariadb",
            "sqlite",
            "sqlserver",
            "oracle",
            "other"
          ],
          "description": "The SQL dialect of the service's database; the page prints the CREATE TABLE statement in it."
        },
        "data_changes": {
          "type": "array",
          "description": "Statements a data migration runs on existing rows (UPDATE, INSERT, a backfill), shown under the CREATE TABLE diff.",
          "items": {
            "type": "object",
            "properties": {
              "sql": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "description": "Markdown subset: `code`, **bold** and [text](https://...). Everything else is shown as text."
              },
              "ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "required": [
                  "sql"
                ]
              },
              {
                "required": [
                  "summary"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "area",
        "status",
        "source",
        "ref"
      ]
